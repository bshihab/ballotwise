# Copy to .env and fill in. All keys are optional — without them the app runs
# on bundled mock data so you can develop the full flow offline.

# Google Civic Information API (elections + voterInfoQuery / ballot data).
# Get one at https://console.cloud.google.com/ -> enable "Civic Information API".
EXPO_PUBLIC_GOOGLE_CIVIC_API_KEY=

# YouTube Data API v3 (candidate video recommendations).
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Anthropic / Claude (candidate chatbot + auto summaries).
# For local dev you can put the key here. For production, leave this blank and
# set EXPO_PUBLIC_AI_PROXY_URL to your own backend that holds the key.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-6
EXPO_PUBLIC_AI_PROXY_URL=
